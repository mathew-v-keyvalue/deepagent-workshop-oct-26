# Base URL of the LiteLLM proxy. Must end in /v1 (NOT /chat/completions).
LITELLM_BASE_URL=https://your-litellm-host/v1
LITELLM_API_KEY=sk-your-litellm-key
# Exact model alias from the proxy's model list. Must support tool calling.
LITELLM_MODEL=gpt-4o-mini

# Optional: trace every run in LangSmith (https://smith.langchain.com)
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=deepagents-research-assistant
